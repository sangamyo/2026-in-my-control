# development | production
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas / Railway MongoDB)
MONGO_URI=mongodb://localhost:27017/goaltracker

# Port for backend (Railway injects PORT automatically)
PORT=4000

# Secret used to sign JWTs. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: token lifetime (jsonwebtoken format, e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS, comma-separated.
# localhost:5173 is always allowed when NODE_ENV is not production.
CLIENT_URL=http://localhost:5173

# AI config (placeholder; the built-in heuristic engine is used)
AI_PROVIDER=stub
